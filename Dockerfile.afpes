# hbbs/hbbr oficiais + extensões AFPES (src/afpes.rs): troca de chaves e login obrigatório.
# Build: docker build -f Dockerfile.afpes -t afpes/remoto-servidor .
FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
# testes das extensões antes de gerar os binários
RUN cargo test --release --lib afpes && cargo build --release --bin hbbs --bin hbbr

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/hbbs /src/target/release/hbbr /usr/bin/
WORKDIR /root
